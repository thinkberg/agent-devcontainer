#!/bin/bash
# review-tick-has-date <file>
# A box ticked in a review protocol marks "decision reached". The same
# edit must add a dated outcome note: a line containing "Review YYYY-MM-DD".
set -uo pipefail
f=${1:?usage: review-tick-has-date <file>}; dir=$(dirname "$f")
if git -C "$dir" ls-files --error-unmatch "$f" >/dev/null 2>&1; then diff=$(git -C "$dir" diff HEAD -- "$f")
else diff=$(git -C "$dir" diff --no-index /dev/null "$f" 2>/dev/null); fi
ticks=$(grep -cE '^\+.*\[x\]' <<<"$diff" || true)
[ "$ticks" -gt 0 ] || exit 0
grep -qE '^\+.*Review [0-9]{4}-[0-9]{2}-[0-9]{2}' <<<"$diff" && exit 0
echo "$f: $ticks box(es) ticked without a dated 'Review YYYY-MM-DD: …' outcome note in the same edit — the tick marks a decision, not done work"
exit 1
